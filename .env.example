# Cloudflare Worker JWT Secret (generate a random string)
# Used to sign and verify JWT tokens for authentication
JWT_SECRET="your-secret-key-change-in-production"

# Gemini API Key (for legacy/fallback AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cloudflare Worker AI is the primary AI provider (no key needed - uses Workers AI binding)


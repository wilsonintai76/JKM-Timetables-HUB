{
  "name": "jkm-timetables-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:init": "wrangler d1 execute jkm-timetables-db --file=worker/db/schema.sql",
    "db:seed": "wrangler d1 execute jkm-timetables-db --file=worker/db/seed.sql",
    "db:init:local": "wrangler d1 execute jkm-timetables-db --file=worker/db/schema.sql --local",
    "db:seed:local": "wrangler d1 execute jkm-timetables-db --file=worker/db/seed.sql --local",
    "kv:create": "wrangler kv:namespace create jkm-timetables-kv",
    "r2:create": "wrangler r2 bucket create jkm-timetables-files",
    "types": "wrangler types",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hono/node-server": "^2.0.12",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "hono": "^4.12.32",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wrangler": "^4.38.0"
  }
}

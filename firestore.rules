rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isAdvisor() {
      return hasRole('ADVISOR');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['id', 'email', 'name', 'role']) &&
               data.id == request.auth.uid &&
               data.email == request.auth.token.email &&
               data.role in ['STUDENT', 'ADVISOR', 'ADMIN'];
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'profile', 'matrixNo']);
    }

    // --- Registrations ---
    match /registrations/{regId} {
      function isValidRegistration(data) {
        return data.keys().hasAll(['id', 'studentId', 'studentName', 'matrixNo', 'status', 'timestamp']) &&
               data.status in ['PENDING', 'APPROVED', 'REJECTED'];
      }

      allow read: if isSignedIn() && (isOwner(resource.data.studentId) || isAdvisor() || isAdmin());
      allow list: if isSignedIn() && (isAdvisor() || isAdmin() || (resource.data.studentId == request.auth.uid));
      allow create: if isSignedIn() && isValidRegistration(request.resource.data) && request.resource.data.studentId == request.auth.uid;
      allow update: if (isAdvisor() || isAdmin()) && 
                      isValidRegistration(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'advisorNotes', 'advisorName']);
    }

    // --- Master Slots ---
    match /masterSlots/{slotId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Feedback ---
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || isAdvisor() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
